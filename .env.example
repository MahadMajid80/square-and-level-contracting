# ─── Site ────────────────────────────────────────────────────────────────
# Canonical production origin. Used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://squareandlevelcontracting.com

# Set to "true" ONLY on the production deployment. Any other value makes every
# page noindex and robots.txt disallow all, so preview/staging URLs never get indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false

# "remote" = load photos from the current WordPress media library (default).
# "local"  = load photos from /public/media after running `npm run assets:download`.
# Switch to "local" BEFORE the WordPress site is taken down.
NEXT_PUBLIC_ASSET_MODE=remote

# ─── Contact form delivery (SMTP) ──────────────────────────────────────────
# Any SMTP provider works (cPanel mailbox, Google Workspace, Postmark, SendGrid, etc.)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# The "From" address. Must be a mailbox your SMTP provider is allowed to send as.
CONTACT_FROM_EMAIL=
# Where enquiries are delivered. Comma-separate multiple addresses.
CONTACT_TO_EMAIL=squareandlevel@telus.net

# ─── Optional bot protection (Cloudflare Turnstile) ────────────────────────
# Leave both empty to rely on the built-in honeypot + timing + rate-limit checks only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Optional analytics ────────────────────────────────────────────────────
# GA4 Measurement ID (G-XXXXXXXXXX). Loaded only after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GSC_VERIFICATION=
